#!/usr/bin/make -f

export DH_VERBOSE = 1
export CARGO := $(shell command -v cargo || command -v cargo-1.78 || echo cargo)

%:
	dh $@

override_dh_auto_configure:
	mkdir -p .cargo
	cp debian/cargo-config.toml .cargo/config.toml
	cp debian/Makefile .

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr

override_dh_clean:
	dh_clean --exclude=vendor
